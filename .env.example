# Copy to .env (gitignored) and fill in a DEDICATED Verified API user (not a personal login).
# Never commit the real .env.

VERIFIED_EMAIL=
VERIFIED_PASSWORD=

# The company the SDK acts for (x-namespace: /companies/<id>). Optional when the user
# belongs to exactly one company: it is then read from /auth/userinfo on first use.
# VERIFIED_COMPANY_ID=

# Tokens are locked to the IP that logged in. Set to 0 for hosts whose egress IP can
# change (Kubernetes without a static NAT IP, laptops on a VPN / Secure Access).
# VERIFIED_IP_LOCK=1

# Only needed to point at another Verified instance.
# VERIFIED_BASE_URL=https://app.verified.eu/api
